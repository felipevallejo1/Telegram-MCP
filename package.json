{
  "name": "medicontrol",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "node scripts/run-tests.mjs",
    "db:migrate": "node scripts/prisma-command.mjs migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "node scripts/db-reset.mjs",
    "db:verify": "tsx scripts/verify-seed.ts",
    "bot": "tsx bot/index.ts"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "typescript": "5.8.3",
    "prisma": "6.19.3",
    "tsx": "4.23.12",
    "vitest": "4.1.10"
  }
}
